{
  "name": "CodeSunny Lead Notification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "codesunny-lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-1",
      "name": "Webhook - Receive Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "codesunny-lead-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.email}}",
              "operation": "contains",
              "value2": "@"
            },
            {
              "value1": "={{$json.name}}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "filter-1",
      "name": "Validate Lead Data",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "fromEmail": "your-email@gmail.com",
        "toEmail": "your-email@gmail.com",
        "subject": "🎯 New Lead: {{$json.name}}",
        "emailType": "html",
        "message": "<!DOCTYPE html>\n<html>\n<body style=\"font-family: Arial, sans-serif;\">\n  <div style=\"max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #ddd; border-radius: 8px;\">\n    <h2 style=\"color: #2563eb;\">🎯 New Lead from CodeSunny Website</h2>\n    <div style=\"background: #f8fafc; padding: 15px; border-radius: 5px; margin: 20px 0;\">\n      <p><strong>👤 Name:</strong> {{$json.name}}</p>\n      <p><strong>📧 Email:</strong> <a href=\"mailto:{{$json.email}}\">{{$json.email}}</a></p>\n      <p><strong>📅 Date:</strong> {{$json.created_at}}</p>\n    </div>\n    <div>\n      <h3>💬 Message:</h3>\n      <p style=\"background: #fff; padding: 15px; border-left: 4px solid #2563eb;\">{{$json.message}}</p>\n    </div>\n  </div>\n</body>\n</html>",
        "options": {}
      },
      "id": "email-1",
      "name": "Email to You",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [650, 200],
      "credentials": {
        "smtp": {
          "id": "1",
          "name": "Gmail SMTP"
        }
      }
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "sheet",
        "operation": "append",
        "documentId": "YOUR_GOOGLE_SHEET_ID",
        "sheetName": "Leads",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Name": "={{$json.name}}",
            "Email": "={{$json.email}}",
            "Message": "={{$json.message}}",
            "Date": "={{$json.created_at}}",
            "Status": "New"
          }
        },
        "options": {}
      },
      "id": "sheets-1",
      "name": "Save to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [650, 400],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "2",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "noreply@codesunny.com",
        "toEmail": "={{$json.email}}",
        "subject": "Thanks for reaching out to CodeSunny! 🚀",
        "emailType": "html",
        "message": "<!DOCTYPE html>\n<html>\n<body style=\"font-family: Arial, sans-serif;\">\n  <div style=\"max-width: 600px; margin: 0 auto; padding: 20px;\">\n    <h2 style=\"color: #2563eb;\">Hi {{$json.name}}! 👋</h2>\n    <p>Thank you for your interest in CodeSunny!</p>\n    <p>We've received your message and our team will get back to you within 24 hours.</p>\n    <div style=\"background: #f8fafc; padding: 15px; border-radius: 5px; margin: 20px 0;\">\n      <p><strong>Your message:</strong></p>\n      <p>{{$json.message}}</p>\n    </div>\n    <p>In the meantime, feel free to:</p>\n    <ul>\n      <li>Check out our <a href=\"https://codesunny.com/services\">services</a></li>\n      <li>View our <a href=\"https://codesunny.com/portfolio\">portfolio</a></li>\n      <li>Read our <a href=\"https://codesunny.com/blog\">blog</a></li>\n    </ul>\n    <p>Best regards,<br>CodeSunny Team</p>\n  </div>\n</body>\n</html>",
        "options": {}
      },
      "id": "email-2",
      "name": "Auto-Reply to Client",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [650, 600],
      "credentials": {
        "smtp": {
          "id": "1",
          "name": "Gmail SMTP"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"message\": \"Lead received successfully\" } }}"
      },
      "id": "respond-1",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Webhook - Receive Lead": {
      "main": [
        [
          {
            "node": "Validate Lead Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Lead Data": {
      "main": [
        [
          {
            "node": "Email to You",
            "type": "main",
            "index": 0
          },
          {
            "node": "Save to Google Sheets",
            "type": "main",
            "index": 0
          },
          {
            "node": "Auto-Reply to Client",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email to You": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save to Google Sheets": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Auto-Reply to Client": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
