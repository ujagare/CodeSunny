PORT=5000
NODE_ENV=development
USE_VITE_DEV_SERVER=true
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/app
JWT_SECRET=change_this_to_a_long_random_secret
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
CORS_ORIGIN=http://localhost:5000
APP_URL=http://localhost:5000
MCP_URL=https://codesunny-mcp.onrender.com/mcp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@codesunny.com
REQUIRE_EMAIL_VERIFICATION=true
LOG_LEVEL=http
REDIS_URL=
MCP_QUEUE_NAME=mcp-heavy-jobs
MCP_JOB_ATTEMPTS=3
MCP_JOB_BACKOFF_MS=2000
MCP_JOB_CONCURRENCY=3
