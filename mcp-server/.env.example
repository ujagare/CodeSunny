OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Image generation
FREEPIK_API_KEY=your_freepik_api_key_here
FREEPIK_API_URL=https://api.freepik.com/v1/ai/text-to-image

# Google SEO audit (PageSpeed Insights API key)
GOOGLE_PAGESPEED_API_KEY=your_google_pagespeed_api_key_here

# Google integrations via webhook (Apps Script / Cloud Run)
# Quote rows -> Google Sheets
GOOGLE_SHEETS_WEBHOOK_URL=
# Calendar booking -> Google Calendar + Meet link
GOOGLE_CALENDAR_WEBHOOK_URL=

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=codesunny
MONGODB_LEADS_COLLECTION=leads

# Optional lead automation webhook (n8n / Zapier / Make)
LEAD_AUTOMATION_WEBHOOK_URL=

# Inbound email AI auto-reply (client replies -> AI reads -> sends response)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# Automation Hub
# once = run one cycle and exit, loop = run continuously
AUTOMATION_HUB_MODE=loop
AUTOMATION_POLL_SECONDS=300

# Weekly SEO report URLs (comma-separated)
SEO_REPORT_URLS=https://codesunny.com,https://codesunny.com/contact

# Uptime/SSL monitor domains (comma-separated)
MONITOR_DOMAINS=codesunny.com
